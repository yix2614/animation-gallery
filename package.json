{
  "name": "transitery",
  "version": "0.1.0",
  "description": "Routed full-screen grid transitions for React — 18 built-in WebGL/canvas effects, drop-in provider and link interception.",
  "license": "MIT",
  "author": "yix2614",
  "type": "module",
  "keywords": [
    "react",
    "transition",
    "page-transition",
    "route-transition",
    "webgl",
    "animation",
    "grid"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yix2614/animation-gallery.git"
  },
  "homepage": "https://github.com/yix2614/animation-gallery#readme",
  "bugs": {
    "url": "https://github.com/yix2614/animation-gallery/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:lib": "vite build --config vite.lib.config.ts",
    "preview": "vite preview --host 0.0.0.0",
    "prepublishOnly": "npm run build:lib"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-popover": "^1.1.23",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "lucide-react": "^1.47.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vite-plugin-dts": "^4.5.4"
  }
}
